+# Instruction-count preamble. This replaces the generic TCG load/subtract/branch/store
+# sequence for Madeira-SE TCTI TBs. The stream contains, after this gadget, the
+# negative env offset, the guest instruction count, the TB_EXIT_REQUESTED value,
+# and a pointer to the first body gadget. When the budget is insufficient we
+# return before the body and leave the low counter unchanged, matching QEMU's
+# generic icount path.
+simple("tb_icount",
+    "ldr x24, [x28], #8",
+    "add x24, x14, x24",
+    "ldr w26, [x24]",
+    "ldr w27, [x28], #8",
+    "subs w26, w26, w27",
+    "b.lt 0f",
+    "strh w26, [x24]",
+    "ldr x28, [x28, #8]",
+    "ldr x27, [x28], #8",
+    "br x27",
+    "0:",
+    "ldr x0, [x28], #8",
+    "ret",
+    epilogue=False
+)
+
 
 
 
