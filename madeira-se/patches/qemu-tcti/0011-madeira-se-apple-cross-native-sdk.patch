diff --git a/configure b/configure
index 000309c..79c51d1 100755
--- a/configure
+++ b/configure
@@ -1843,6 +1843,11 @@ if test "$skip_meson" = no; then

   echo "# Automatically generated by configure - do not modify" > $cross
   echo "[properties]" >> $cross
+  if test "$cross_compile" = "yes"; then
+    # Cross-built Apple targets cannot execute an iPhoneOS binary during
+    # Meson compiler probes.  Keep all build-time generators on host_cc.
+    echo "needs_exe_wrapper = true" >> $cross
+  fi

   # unroll any custom device configs
   for a in $device_archs; do
@@ -1925,7 +1930,18 @@ if test "$skip_meson" = no; then
     native="config-meson.native.new"
     echo "# Automatically generated by configure - do not modify" > $native
     echo "[binaries]" >> $native
-    echo "c = [$(meson_quote $host_cc)]" >> $native
+    # A Darwin build machine still needs an SDK when the selected compiler is
+    # Apple's clang.  Without an explicit macOS sysroot, Meson treats the
+    # native compiler as unusable (it cannot resolve libSystem) and reports
+    # that no C compiler exists for the build machine.  Keep the target
+    # cross-file on the iPhoneOS SDK while giving build-time generators a
+    # macOS compiler that can actually link.
+    native_cc_args=""
+    if test "$cross_compile" = "yes" && test "$host_os" = "darwin"; then
+      native_sdk="$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)"
+      test -n "$native_sdk" && native_cc_args="-isysroot $native_sdk"
+    fi
+    echo "c = [$(meson_quote $host_cc $native_cc_args)]" >> $native
     if test "$rust" != disabled; then
       echo "rust = [$(meson_quote $rustc)]" >> $cross
     fi
