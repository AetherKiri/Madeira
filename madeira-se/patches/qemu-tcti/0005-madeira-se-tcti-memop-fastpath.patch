+void madeira_se_tcti_perf_note_memop(bool is_store, bool is_i64,
+                                     uint32_t memop_idx)
+{
+    MadeiraSeTctiMemopCount *table =
+        memop_counts[is_store != 0][is_i64 != 0];
+    unsigned int slot = (memop_idx * 2654435761u)
+        % MADEIRA_SE_TCTI_MEMOP_PROFILE_SLOTS;
+    unsigned int probe;
+
+    for (probe = 0; probe < MADEIRA_SE_TCTI_MEMOP_PROFILE_SLOTS; ++probe) {
+        MadeiraSeTctiMemopCount *entry = &table[slot];
+
+        if (entry->count == 0 || entry->memop_idx == memop_idx) {
+            entry->memop_idx = memop_idx;
+            entry->count++;
+            return;
+        }
+        slot = (slot + 1) % MADEIRA_SE_TCTI_MEMOP_PROFILE_SLOTS;
+    }
+}
+
+void madeira_se_tcti_perf_dump_memops(void)
+{
+    struct memop_entry {
+        uint64_t count;
+        uint32_t memop_idx;
+        uint8_t is_store;
+        uint8_t is_i64;
+    };
+    struct memop_entry top[MADEIRA_SE_TCTI_TOP_MEMOPS] = { 0 };
+    unsigned int is_store;
+    unsigned int is_i64;
+    unsigned int bucket;
+
+    if (memops_dumped) return;
+    memops_dumped = true;
+    for (is_store = 0; is_store < 2; ++is_store) {
+        for (is_i64 = 0; is_i64 < 2; ++is_i64) {
+            for (bucket = 0;
+                 bucket < MADEIRA_SE_TCTI_MEMOP_PROFILE_SLOTS;
+                 ++bucket) {
+                const MadeiraSeTctiMemopCount *entry =
+                    &memop_counts[is_store][is_i64][bucket];
+                uint64_t count = entry->count;
+                unsigned int slot;
+
+                if (count == 0
+                    || count <= top[MADEIRA_SE_TCTI_TOP_MEMOPS - 1].count) {
+                    continue;
+                }
+                for (slot = MADEIRA_SE_TCTI_TOP_MEMOPS - 1; slot > 0; --slot) {
+                    if (count <= top[slot - 1].count) break;
+                    top[slot] = top[slot - 1];
+                }
+                top[slot] = (struct memop_entry){
+                    .count = count,
+                    .memop_idx = entry->memop_idx,
+                    .is_store = (uint8_t)is_store,
+                    .is_i64 = (uint8_t)is_i64,
+                };
+            }
+        }
+    }
+    for (unsigned int rank = 0; rank < MADEIRA_SE_TCTI_TOP_MEMOPS; ++rank) {
+        const struct memop_entry *entry = &top[rank];
+
+        if (entry->count == 0) break;
+        fprintf(stderr,
+                "MADEIRA_SE_TCTI_MEMOP rank=%u kind=%s width=%s "
+                "idx=0x%08" PRIx32 " count=%" PRIu64 "\n",
+                rank + 1, entry->is_store ? "st" : "ld",
+                entry->is_i64 ? "i64" : "i32",
+                entry->memop_idx, entry->count);
+    }
+}
