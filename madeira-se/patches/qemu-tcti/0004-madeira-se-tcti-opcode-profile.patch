 {
     madeira_se_tcti_perf_state.tb_translations++;
     madeira_se_tcti_perf_state.translated_instructions += guest_instructions;
+    /* The FPS runner terminates long-lived titles after sampling. Emit one
+     * usable profile before that forced termination if enough TBs were seen. */
