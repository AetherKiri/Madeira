@@ -15,9 +15,18 @@
 
 MadeiraSeTctiPerfState madeira_se_tcti_perf_state;
 
+#define MADEIRA_SE_TCTI_OP_PROFILE_LIMIT 256u
+#define MADEIRA_SE_TCTI_TOP_PAIRS 32u
+
+static uint64_t opcode_pair_counts[MADEIRA_SE_TCTI_OP_PROFILE_LIMIT]
+    [MADEIRA_SE_TCTI_OP_PROFILE_LIMIT];
+static const char *opcode_names[MADEIRA_SE_TCTI_OP_PROFILE_LIMIT];
+static bool opcode_pairs_dumped;
+
 bool madeira_se_tcti_perf_enabled(void)
 {
     static int enabled = -1;
+    static bool dump_registered;
 
     if (enabled < 0) {
         const char *value = getenv("MADEIRA_SE_PERF_STATS");
@@ -27,6 +36,10 @@
             && strcasecmp(value, "off") != 0
             && strcasecmp(value, "no") != 0
             && strcasecmp(value, "false") != 0;
+        if (enabled != 0 && !dump_registered) {
+            atexit(madeira_se_tcti_perf_dump_opcode_pairs);
+            dump_registered = true;
+        }
     }
     return enabled != 0;
 }
