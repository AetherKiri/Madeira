+
+/* Keep several instruction budgets resident in the QEMU CPU thread before
+ * returning to Wine.  This removes repeated run_on_cpu, context save/restore,
+ * and condition-variable handshakes while retaining the dispatcher page
+ * checks that stop at every syscall or Unix call. */
+static unsigned int madeira_se_cpu_batch_slices(void)
+{
+    static int initialized;
+    static unsigned int slices;
+    const char *value;
+    char *end;
+    unsigned long parsed;
+
+    if (initialized) return slices;
+    initialized = 1;
+    slices = 1;
+    value = getenv("MADEIRA_SE_CPU_BATCH_SLICES");
+    if (!value || !*value) return slices;
+    errno = 0;
+    parsed = strtoul(value, &end, 10);
+    if (!errno && end != value && !*end && parsed >= 1 && parsed <= 16)
+        slices = (unsigned int)parsed;
+    return slices;
 }
 
 static bool madeira_se_architecture_supported(madeira_se_architecture_t architecture)
@@ -367,6 +392,16 @@
 static void madeira_se_flush_translations(void)
 {
     if (first_cpu != NULL) {
+        /*
+         * The embedded adapter changes the AddressSpace from a Wine thread
+         * after a guest page fault.  Unlike a normal SoftMMU memory-listener
+         * transaction, this path does not pass through tcg_commit(), so the
+         * CPU can retain a negative/read-only TLB entry for the faulting page.
+         * Flush both translated blocks and the per-CPU TLB before retrying the
+         * instruction; otherwise a successful lazy map can fault a second
+         * time and corrupt the guest exception context.
+         */
+        tlb_flush(first_cpu);
         tb_flush(first_cpu);
     }
 }
